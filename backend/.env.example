# Copy this file to .env. Never commit the completed .env file.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# A public @username, a t.me link, or the exact group/channel name.
TELEGRAM_GROUP=

# Kept locally for this proof of concept.
DATABASE_PATH=data/comvoly.db

# Production only: Neon pooled PostgreSQL connection string.
DATABASE_URL=

# Production worker only. Export from the authorised local session with
# python src\export_telegram_session.py and store only as a Railway secret.
TELEGRAM_SESSION_STRING=

# Required for grounded community answers. Create at platform.openai.com/api-keys.
OPENAI_API_KEY=

# Low-latency testing defaults. Raise reasoning to low or switch to Terra if needed.
COMVOLY_AI_MODEL=gpt-5.6-luna
COMVOLY_AI_REASONING=none
COMVOLY_AI_MAX_OUTPUT_TOKENS=700

# Explicit v2 interpretation gate and conservative per-workspace monthly allowance.
# Keep disabled in production until the AI privacy, entitlement and cost rollout.
COMVOLY_AI_INTERPRETATION_ENABLED=false
COMVOLY_AI_MONTHLY_QUESTION_LIMIT=50

# Created automatically by: python src\configure_owner.py
# Do not enter a plain-text password here.
COMVOLY_OWNER_PASSWORD_HASH=
COMVOLY_SESSION_SECRET=

# Use true only when the API is served over HTTPS in production.
COMVOLY_SECURE_COOKIES=false
COMVOLY_WEB_ORIGIN=http://localhost:3000

# V2 foundation gates. Leave false in production until the reviewed rollout.
COMVOLY_ENABLE_V2_SCHEMA=false
COMVOLY_ENABLE_V2_API=false

# Local development only. Never enable this adapter in production.
COMVOLY_V2_DEV_AUTH=false
COMVOLY_V2_DEV_SECRET=

# Managed identity development rollout. Keep every value unset in production until
# the separately reviewed production activation. The issuer and JWKS URL must belong
# to the same isolated Neon Auth branch/project.
COMVOLY_IDENTITY_PROVIDER=
NEON_AUTH_ISSUER=
NEON_AUTH_JWKS_URL=
NEON_AUTH_AUDIENCE=
NEON_AUTH_JWT_ALGORITHMS=EdDSA,ES256,RS256

# Development only: valid new identities become accounts with zero memberships.
# Signup never grants access to a workspace or any community content.
COMVOLY_V2_SELF_REGISTRATION=false

# Separate commercial/owner approval gate. Registration never implies permission to
# create a workspace.
COMVOLY_V2_ALLOW_WORKSPACE_CREATION=false

# Maximum JSON body accepted by the built-in API. The development Telegram export UI
# uses a lower 25 MiB client limit and uploads normalised batches of at most 500 items.
COMVOLY_MAX_JSON_BYTES=31457280
COMVOLY_PUBLIC_API_URL=https://your-isolated-api.example
COMVOLY_TELEGRAM_BOT_USER_ID=
COMVOLY_TELEGRAM_BOT_USERNAME=
COMVOLY_TELEGRAM_WEBHOOK_MASTER_KEY=
COMVOLY_TELEGRAM_BOT_TOKEN=
